{%- extends '@WexampleSymfonyLoaderTestingBundle/layouts/demo/layout.html.twig' -%}

{%- block page_body -%}
    <div class="stack--horizontal">
        <div class="block block--body">
            {{ '@page::layout_modal.body' | trans }}
        </div>
        <div class="block block--body">
            {{ component(render_pass, '@WexampleSymfonyLoaderBundle/components/button', {id:'page-modal-show', text:'Test Two', icon:'material:check'}) }}
        </div>
    </div>
    <div class="block block--body">
        {{ vue(render_pass, '@WexampleSymfonyLoaderBundle/pages/demo/vue/demo-vue-component') }}
    </div>
    {{ vue(render_pass, '@WexampleSymfonyLoaderBundle/vue/debug-assets') }}
{%- endblock -%}