{%- extends '@WexampleSymfonyLoaderTestingBundle/layouts/demo/layout.html.twig' -%}

{%- block page_body -%}
    <div class="block block--body">
        Cette page contient une feuille de style spécifique qui se charge autant en pleine page que dans une modale ou
        un panneau.
    </div>
    <div class="stack--horizontal">
        <div class="block block--body">
            {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/button', {class:'open-another-modal', label:'Ouvrir une autre modale'}) }}
        </div>
        <div class="block block--body">
            {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/button', {class:'close-all-panels-and-modals', label:'Tout fermer'}) }}
        </div>
    </div>
{%- endblock -%}